{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "wcs-repos software index v3",
  "type": "object",
  "required": ["schema_version", "software", "version", "platform", "components"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": 3 },
    "software": { "type": "string" },
    "version": { "type": "string" },
    "variant": { "type": "string" },
    "release_date": { "type": "string" },
    "language": { "type": "string" },
    "install": { "type": "string" },
    "platform": {
      "type": "object",
      "required": ["os", "arch"],
      "properties": {
        "os": { "const": "linux" },
        "arch": { "const": "x86_64" },
        "libc": { "type": "string" }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "version", "filename", "url", "sha256"],
        "additionalProperties": true,
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" },
          "filename": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "role": { "enum": ["runtime", "package-manager", "source", "toolchain", "installer", "std"] },
          "provides": { "type": "array", "items": { "type": "string" } },
          "format": { "type": "string" },
          "abi": { "type": "string" },
          "libc": { "type": "string" },
          "upstream": { "type": "string" },
          "source": { "type": "string" },
          "freethreaded": { "type": "boolean" },
          "bundled_components": { "type": "object" },
          "paired_with": { "type": "object" }
        }
      }
    }
  }
}
